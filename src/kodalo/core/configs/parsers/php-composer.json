{
  "schema_version": 1,
  "id": "php-composer",
  "ecosystem": "php",
  "files": [
    "composer.json"
  ],
  "lockfiles": [
    "composer.lock"
  ],
  "format": "json",
  "name": [
    "name"
  ],
  "version": [
    "version"
  ],
  "dependencies": [
    {
      "path": "require",
      "shape": "keys"
    }
  ],
  "dev_dependencies": [
    {
      "path": "require-dev",
      "shape": "keys"
    }
  ],
  "exclude_dependencies": [
    "php",
    "ext-*"
  ]
}
