{
  "schema_version": 1,
  "id": "cpp-cmake",
  "ecosystem": "cpp",
  "files": [
    "CMakeLists.txt"
  ],
  "format": "lines",
  "name": [
    "(?i)^\\s*project\\(\\s*(?P<value>[\\w.\\-]+)"
  ],
  "version": [
    "(?i)\\bVERSION\\s+(?P<value>\\d[\\w.]*)"
  ],
  "dependencies": [
    {
      "regex": "(?i)^\\s*find_package\\(\\s*(?P<value>[\\w.\\-]+)"
    }
  ]
}
